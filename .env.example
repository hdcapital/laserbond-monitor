# lbl-tracker secrets. Copy to .env for local runs; in GitHub Actions these
# are repository secrets with the same names.

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html) - free key,
# required for the US steel new-orders series (g).
FRED_API_KEY=

# Anthropic API key - required for ASX announcement PDF classification (l).
ANTHROPIC_API_KEY=

# Monthly email brief via SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=            # comma-separated recipients

# Optional: contact email placed in the SEC EDGAR User-Agent (polite; EDGAR
# asks for a way to contact the requester).
SEC_CONTACT_EMAIL=

# Optional: bill-of-lading shipment data. The importgenius module stays
# dormant (logs and exits) when this is empty.
IMPORTGENIUS_API_KEY=
